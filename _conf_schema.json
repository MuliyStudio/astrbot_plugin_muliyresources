  "novel": {
    "description": "小说搜索与下载",
    "hint": "so-novel 服务地址与下载格式；令牌、超时在「更多配置」里。",
    "type": "object",
    "default": {},
    "items": {
      "sonovel_base_url": {
        "type": "string",
        "description": "so-novel Web 服务地址",
        "default": "http://127.0.0.1:7765",
        "hint": "so-novel 以 Web 模式启动后的地址，默认 http://127.0.0.1:7765。"
      },
      "sonovel_format": {
        "type": "list",
        "description": "默认下载格式（可多选）",
        "default": [
          "txt"
        ],
        "items": {
          "type": "string"
        },
        "hint": "txt / epub / html / pdf，推荐至少保留 txt。"
      },
      "sonovel_token": {
        "type": "string",
        "description": "访问令牌（可选）",
        "default": "",
        "hint": "官方 servlet 不鉴权，留空即可。",
        "collapsed": true
      },
      "sonovel_search_limit": {
        "type": "int",
        "description": "每源搜索结果上限",
        "default": 20,
        "min": 1,
        "max": 50,
        "hint": "默认 20。",
        "collapsed": true
      },
      "sonovel_timeout": {
        "type": "int",
        "description": "搜索/接口网络超时（秒）",
        "default": 30,
        "min": 5,
        "max": 120,
        "hint": "默认 30 秒。",
        "collapsed": true
      },
      "sonovel_download_timeout": {
        "type": "int",
        "description": "整本下载超时（秒）",
        "default": 600,
        "min": 30,
        "max": 1800,
        "hint": "默认 600 秒，大书可能需数分钟。",
        "collapsed": true
      }
    }
  },
  "music": {
    "description": "网易云音乐",
    "hint": "网易云语音名片；自建接口、Cookie、代理在「更多配置」里。",
    "type": "object",
    "default": {},
    "items": {
      "wyy_auto_parse": {
        "type": "bool",
        "description": "网易云语音名片",
        "default": true,
        "hint": "自动识别消息中的网易云链接/小程序分享并发送语音。"
      },
      "wyy_backend": {
        "type": "string",
        "description": "解析后端模式",
        "default": "direct",
        "hint": "direct=内置直连（推荐，零部署）；custom=自建 NeteaseCloudMusicApi。"
      },
      "wyy_music_type": {
        "type": "string",
        "description": "解析音质",
        "default": "standard",
        "hint": "standard/exhigh/lossless/hires/sky/jymaster；部分需会员。"
      },
      "wyy_audio_format": {
        "type": "string",
        "description": "语音音频格式",
        "default": "wav",
        "hint": "mp3（QQ 兼容好，推荐）/ wav。"
      },
      "wyy_custom_url": {
        "type": "string",
        "description": "自建 NeteaseCloudMusicApi 地址",
        "default": "",
        "hint": "仅 wyy_backend=custom 时需要，如 http://127.0.0.1:3000。",
        "condition": {
          "wyy_backend": "custom"
        },
        "collapsed": true
      },
      "wyy_clip_seconds": {
        "type": "int",
        "description": "最大发送歌曲时长（秒）",
        "default": 600,
        "min": 10,
        "max": 600,
        "hint": "默认 600（10 分钟）；建议 180-400。",
        "collapsed": true
      },
      "wyy_cookie": {
        "type": "string",
        "description": "黑胶会员 Cookie（用于解析 VIP 歌曲）",
        "default": "",
        "hint": "留空只能解析免费歌；填会员 Cookie（含 MUSIC_U）可解析 VIP。",
        "collapsed": true
      },
      "wyy_proxy": {
        "type": "string",
        "description": "网易云请求代理（可选）",
        "default": "",
        "hint": "留空直连；服务器 IP 被风控时填代理。",
        "collapsed": true
      }
    }
  },
  "vip_video": {
    "description": "VIP 视频解析",
    "hint": "爱奇艺/腾讯/优酷/芒果 VIP 链接解析。",
    "type": "object",
    "default": {},
    "items": {
      "video_vip_parse": {
        "type": "bool",
        "description": "VIP 视频解析（爱奇艺/腾讯/优酷/芒果等）",
        "default": true,
        "hint": "开启后自动把受支持的 VIP 视频链接解析为播放直链。"
      },
      "video_vip_timeout": {
        "type": "int",
        "description": "单个解析站超时（毫秒）",
        "default": 25000,
        "min": 8000,
        "max": 60000,
        "hint": "默认 25000 毫秒。",
        "collapsed": true
      }
    }
  },
  "verify": {
    "description": "入群审核（QQ）",
    "hint": "QQ 新成员图形验证码审核；超时/机会/撤回等在「更多配置」里。",
    "type": "object",
    "default": {},
    "items": {
      "join_verify_enabled": {
        "type": "bool",
        "description": "入群审核总开关",
        "default": false,
        "hint": "默认关闭。开启后新成员入群需完成图形验证码验证，否则会被移出群聊。"
      },
      "join_verify_group_ids": {
        "type": "list",
        "description": "生效群 ID（白名单）",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "只在这些群启用审核；留空表示所有群生效。建议填写，避免影响其它群。",
        "condition": {
          "join_verify_enabled": true
        }
      },
      "join_verify_timeout": {
        "type": "int",
        "description": "验证限时（秒）",
        "default": 120,
        "min": 30,
        "max": 600,
        "hint": "默认 120 秒（2 分钟）。超时未通过将被移出群聊。",
        "condition": {
          "join_verify_enabled": true
        },
        "collapsed": true
      },
      "join_verify_max_attempts": {
        "type": "int",
        "description": "答题机会（次）",
        "default": 2,
        "min": 1,
        "max": 5,
        "hint": "默认 2 次，即第 2 次答错立即移出群聊（仅统计含数字的发言）。",
        "condition": {
          "join_verify_enabled": true
        },
        "collapsed": true
      },
      "join_verify_recall": {
        "type": "bool",
        "description": "验证期间撤回消息（成员发言 + 机器人验证消息）",
        "default": true,
        "hint": "开启后（需机器人有管理权限）会撤回待验证成员的消息防刷屏，并在验证结束（通过/失败/超时）时把机器人本次发的验证消息一并撤回，做到不留痕。关闭则仅提示、不撤回。",
        "condition": {
          "join_verify_enabled": true
        },
        "collapsed": true
      },
      "join_verify_kick": {
        "type": "bool",
        "description": "验证失败时移出群聊",
        "default": true,
        "hint": "关闭后只撤回首屏消息，不踢人（适合先观察）。",
        "condition": {
          "join_verify_enabled": true
        },
        "collapsed": true
      },
      "join_verify_welcome_text": {
        "type": "string",
        "description": "验证通过后的欢迎词",
        "default": "✅ 验证成功，欢迎加入群聊！",
        "hint": "验证通过时会先撤回机器人本次发的验证消息，只保留这一条；留空则静默通过（不发送任何消息）。",
        "condition": {
          "join_verify_enabled": true
        },
        "collapsed": true
      }
    }
  },
  "points": {
    "description": "签到与积分",
    "hint": "签到与积分系统；初始积分、连续加成、推荐清单、搜索消耗在「更多配置」里。",
    "type": "object",
    "default": {},
    "items": {
      "points_enabled": {
        "type": "bool",
