{
  "game": {
    "description": "游戏资源",
    "hint": "游戏搜索源与游戏日报设置。",
    "type": "object",
    "default": {},
    "items": {
      "game_source": {
        "type": "string",
        "description": "游戏搜索源",
        "default": "auto",
        "hint": "auto（默认）：有 xdgame 账密走 xdgame，否则走 switch618；也可填 xdgame / switch618 强制。"
      },
      "max_search_results": {
        "type": "int",
        "description": "最大搜索结果数",
        "default": 32,
        "min": 1,
        "max": 48,
        "hint": "默认 32，最大 48。"
      },
      "game_report_enabled": {
        "type": "bool",
        "description": "游戏日报总开关",
        "default": true,
        "hint": "开启后按本组时间每天自动推送游戏日报到「游戏日报推送群」；时间与群号仅在本组填写，不要填到其它分组。"
      },
      "game_report_max": {
        "type": "int",
        "description": "游戏日报每期最多游戏数",
        "default": 24,
        "min": 1,
        "max": 50,
        "hint": "默认 24，最大 50。",
        "condition": {"game_report_enabled": true}
      },
      "game_schedule_hour": {
        "type": "int",
        "description": "游戏日报推送小时（0-23）",
        "default": 23,
        "min": 0,
        "max": 23,
        "hint": "游戏日报独立定时，与软件/影视/短剧日报分开。",
        "condition": {"game_report_enabled": true}
      },
      "game_schedule_minute": {
        "type": "int",
        "description": "游戏日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。",
        "condition": {"game_report_enabled": true}
      },
      "game_group_ids": {
        "type": "list",
        "description": "游戏日报推送群 ID",
        "default": [],
        "items": {"type": "string"},
        "hint": "填入群号，可多个；留空则不推送。",
        "condition": {"game_report_enabled": true}
      },
      "xdgame_username": {
        "type": "string",
        "description": "xdgame.com 账号",
        "default": "",
        "hint": "用于 /game_cookie_refresh 自动登录刷新 Cookie。"
      },
      "xdgame_password": {
        "type": "string",
        "description": "xdgame.com 密码",
        "default": "",
        "hint": "用于 /game_cookie_refresh 自动登录刷新 Cookie。"
      },
      "cookie": {
        "type": "text",
        "description": "xdgame.com Cookie",
        "default": "",
        "hint": "自动登录后写入，一般无需手填。"
      },
      "switch618_cookie": {
        "type": "text",
        "description": "switch618.com 登录 Cookie",
        "default": "",
        "hint": "switch618 源扫码登录后自动写入，一般无需手填。"
      }
    }
  },
  "software": {
    "description": "软件资源",
    "hint": "软件日报独立定时推送设置。",
    "type": "object",
    "default": {},
    "items": {
      "schedule_hour": {
        "type": "int",
        "description": "软件日报推送小时（0-23）",
        "default": 22,
        "min": 0,
        "max": 23,
        "hint": "软件日报独立定时，与游戏/影视/短剧日报分开。"
      },
      "schedule_minute": {
        "type": "int",
        "description": "软件日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。"
      },
      "group_ids": {
        "type": "list",
        "description": "软件日报推送群 ID",
        "default": [],
        "items": {"type": "string"},
        "hint": "填入群号，可多个；留空则不推送。"
      }
    }
  },
  "movie": {
    "description": "影视资源",
    "hint": "影视搜索源与影视日报设置。",
    "type": "object",
    "default": {},
    "items": {
      "movie_source": {
        "type": "string",
        "description": "影视搜索源",
        "default": "",
        "hint": "留空自动：有片库登录走片库新站，否则回退 a123tv；也可填「片库」/「a123tv」强制。"
      },
      "muliy_cache_ttl": {
        "type": "int",
        "description": "新站登录态缓存秒数",
        "default": 3600,
        "min": 300,
        "max": 86400,
        "hint": "默认 3600 秒，到期自动重登。"
      },
      "movie_report_enabled": {
        "type": "bool",
        "description": "影视日报总开关",
        "default": true,
        "hint": "开启后按本组时间每天推送影视日报（未配片库时自动用 a123tv 免登录出报）。"
      },
      "movie_report_max": {
        "type": "int",
        "description": "影视日报每个区块最多部数",
        "default": 24,
        "min": 1,
        "max": 50,
        "hint": "电影/剧集/动漫每块各取前 N 部，默认 24。",
        "condition": {"movie_report_enabled": true}
      },
      "movie_schedule_hour": {
        "type": "int",
        "description": "影视日报推送小时（0-23）",
        "default": 20,
        "min": 0,
        "max": 23,
        "hint": "影视日报独立定时，与软件/游戏/短剧日报分开。",
        "condition": {"movie_report_enabled": true}
      },
      "movie_schedule_minute": {
        "type": "int",
        "description": "影视日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。",
        "condition": {"movie_report_enabled": true}
      },
      "movie_group_ids": {
        "type": "list",
        "description": "影视日报推送群 ID",
        "default": [],
        "items": {"type": "string"},
        "hint": "填入群号，可多个；留空则不推送。",
        "condition": {"movie_report_enabled": true}
      },
      "movie_sections": {
        "type": "list",
        "description": "影视日报包含的区块",
        "default": ["mv", "tv", "ac"],
        "items": {"type": "string"},
        "hint": "mv=电影 / tv=剧集 / ac=动漫，可多选。",
        "condition": {"movie_report_enabled": true}
      },
      "muliy_release_url": {
        "type": "string",
        "description": "影视发布页地址（选填）",
        "default": "",
        "hint": "留空即用默认发布页，一般无需填写。"
      },
      "muliy_username": {
        "type": "string",
        "description": "片库（新站）账号（选填）",
        "default": "",
        "hint": "选填。与密码搭配，插件自动登录片库新站，无需搬 Cookie。"
      },
      "muliy_password": {
        "type": "string",
        "description": "片库（新站）密码（选填）",
        "default": "",
        "hint": "选填。与账号搭配自动登录。"
      },
      "muliy_cookie": {
        "type": "text",
        "description": "片库（新站）Cookie（选填，可用账号密码替代）",
        "default": "",
        "hint": "选填。含 app_auth、PHPSESSID 即可；勿填 browser_verified / browser_pow（插件会自动求解）。"
      }
    }
  },
  "music": {
    "description": "网易云音乐",
    "hint": "网易云语音名片 / 歌曲解析设置。",
    "type": "object",
    "default": {},
    "items": {
      "wyy_auto_parse": {
        "type": "bool",
        "description": "网易云语音名片",
        "default": true,
        "hint": "自动识别消息中的网易云链接/小程序分享并发送语音。"
      },
      "wyy_backend": {
        "type": "string",
        "description": "解析后端模式",
        "default": "direct",
        "hint": "direct=内置直连（推荐，零部署）；custom=自建 NeteaseCloudMusicApi。"
      },
      "wyy_music_type": {
        "type": "string",
        "description": "解析音质",
        "default": "standard",
        "hint": "standard/exhigh/lossless/hires/sky/jymaster；部分需会员。"
      },
      "wyy_custom_url": {
        "type": "string",
        "description": "自建 NeteaseCloudMusicApi 地址",
        "default": "",
        "hint": "仅 wyy_backend=custom 时需要，如 http://127.0.0.1:3000。",
        "condition": {"wyy_backend": "custom"}
      },
      "wyy_clip_seconds": {
        "type": "int",
        "description": "最大发送歌曲时长（秒）",
        "default": 600,
        "min": 10,
        "max": 600,
        "hint": "默认 600（10 分钟）；建议 180-400。"
      },
      "wyy_audio_format": {
        "type": "string",
        "description": "语音音频格式",
        "default": "wav",
        "hint": "mp3（QQ 兼容好，推荐）/ wav。"
      },
      "wyy_cookie": {
        "type": "string",
        "description": "黑胶会员 Cookie（用于解析 VIP 歌曲）",
        "default": "",
        "hint": "留空只能解析免费歌；填会员 Cookie（含 MUSIC_U）可解析 VIP。"
      },
      "wyy_proxy": {
        "type": "string",
        "description": "网易云请求代理（可选）",
        "default": "",
        "hint": "留空直连；服务器 IP 被风控时填代理。"
      }
    }
  },
  "vip_video": {
    "description": "VIP 视频解析",
    "hint": "爱奇艺/腾讯/优酷/芒果等 VIP 视频链接自动解析设置。",
    "type": "object",
    "default": {},
    "items": {
      "video_vip_parse": {
        "type": "bool",
        "description": "VIP 视频解析（爱奇艺/腾讯/优酷/芒果等）",
        "default": true,
        "hint": "开启后自动把受支持的 VIP 视频链接解析为播放直链。"
      },
      "video_vip_timeout": {
        "type": "int",
        "description": "单个解析站超时（毫秒）",
        "default": 25000,
        "min": 8000,
        "max": 60000,
        "hint": "默认 25000 毫秒。"
      }
    }
  },
  "browser": {
    "description": "浏览器",
    "hint": "Playwright 渲染所用浏览器，游戏日报与 VIP 解析共用。",
    "type": "object",
    "default": {},
    "items": {
      "browser_channel": {
        "type": "string",
        "description": "Playwright 浏览器",
        "default": "",
        "hint": "填 chrome 用本机 Chrome；留空用插件自带 Chromium。"
      },
      "browser_exe": {
        "type": "string",
        "description": "浏览器可执行路径（留空=自动）",
        "default": "",
        "hint": "留空自动选择。"
      }
    }
  },
  "novel": {
    "description": "小说搜索与下载",
    "hint": "基于 so-novel 的多源聚合搜索/下载，需另起一个 so-novel 实例（Web 模式）。",
    "type": "object",
    "default": {},
    "items": {
      "sonovel_base_url": {
        "type": "string",
        "description": "so-novel Web 服务地址",
        "default": "http://127.0.0.1:7765",
        "hint": "so-novel 以 Web 模式启动后的地址，默认 http://127.0.0.1:7765。"
      },
      "sonovel_token": {
        "type": "string",
        "description": "访问令牌（可选）",
        "default": "",
        "hint": "官方 servlet 不鉴权，留空即可。"
      },
      "sonovel_search_limit": {
        "type": "int",
        "description": "每源搜索结果上限",
        "default": 20,
        "min": 1,
        "max": 50,
        "hint": "默认 20。"
      },
      "sonovel_format": {
        "type": "list",
        "description": "默认下载格式（可多选）",
        "default": ["txt"],
        "items": {"type": "string"},
        "hint": "txt / epub / html / pdf，推荐至少保留 txt。"
      },
      "sonovel_timeout": {
        "type": "int",
        "description": "搜索/接口网络超时（秒）",
        "default": 30,
        "min": 5,
        "max": 120,
        "hint": "默认 30 秒。"
      },
      "sonovel_download_timeout": {
        "type": "int",
        "description": "整本下载超时（秒）",
        "default": 600,
        "min": 30,
        "max": 1800,
        "hint": "默认 600 秒，大书可能需数分钟。"
      }
    }
  },
  "shortdrama": {
    "description": "短剧搜索与日报",
    "hint": "网盘贴吧短剧搜索与夸克网盘资源链接，及每日短剧日报。",
    "type": "object",
    "default": {},
    "items": {
      "drama_enabled": {
        "type": "bool",
        "description": "短剧搜索总开关",
        "default": true,
        "hint": "开启后支持「搜短剧XX / 看短剧XX」，选中返回夸克网盘链接。"
      },
      "drama_search_limit": {
        "type": "int",
        "description": "单次搜索结果上限",
        "default": 20,
        "min": 4,
        "max": 40,
        "hint": "默认 20。"
      },
      "drama_report_enabled": {
        "type": "bool",
        "description": "短剧日报总开关",
        "default": true,
        "hint": "开启后按本组时间每天推送短剧日报到「短剧日报推送群」。"
      },
      "drama_report_max": {
        "type": "int",
        "description": "短剧日报每期最多部数",
        "default": 12,
        "min": 1,
        "max": 30,
        "hint": "默认 12，最大 30（每部需额外请求详情页）。",
        "condition": {"drama_report_enabled": true}
      },
      "drama_schedule_hour": {
        "type": "int",
        "description": "短剧日报推送小时（0-23）",
        "default": 21,
        "min": 0,
        "max": 23,
        "hint": "短剧日报独立定时，与软件/游戏/影视日报分开。",
        "condition": {"drama_report_enabled": true}
      },
      "drama_schedule_minute": {
        "type": "int",
        "description": "短剧日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。",
        "condition": {"drama_report_enabled": true}
      },
      "drama_group_ids": {
        "type": "list",
        "description": "短剧日报推送群 ID",
        "default": [],
        "items": {"type": "string"},
        "hint": "填入群号，可多个；留空则不推送。",
        "condition": {"drama_report_enabled": true}
      },
      "drama_timeout": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 15,
        "min": 5,
        "max": 60,
        "hint": "默认 15 秒。"
      }
    }
  },
  "verify": {
    "description": "入群审核（QQ）",
    "hint": "新成员入群后 @ 他并发送图形验证码，限时回复正确答案；答错达上限或超时移出群聊。仅支持 QQ（aiocqhttp / OneBot v11），且机器人需为群管理员。",
    "type": "object",
    "default": {},
    "items": {
      "join_verify_enabled": {
        "type": "bool",
        "description": "入群审核总开关",
        "default": false,
        "hint": "默认关闭。开启后新成员入群需完成图形验证码验证，否则会被移出群聊。"
      },
      "join_verify_group_ids": {
        "type": "list",
        "description": "生效群 ID（白名单）",
        "default": [],
        "items": {"type": "string"},
        "hint": "只在这些群启用审核；留空表示所有群生效。建议填写，避免影响其它群。",
        "condition": {"join_verify_enabled": true}
      },
      "join_verify_timeout": {
        "type": "int",
        "description": "验证限时（秒）",
        "default": 120,
        "min": 30,
        "max": 600,
        "hint": "默认 120 秒（2 分钟）。超时未通过将被移出群聊。",
        "condition": {"join_verify_enabled": true}
      },
      "join_verify_max_attempts": {
        "type": "int",
        "description": "答题机会（次）",
        "default": 2,
        "min": 1,
        "max": 5,
        "hint": "默认 2 次，即第 2 次答错立即移出群聊（仅统计含数字的发言）。",
        "condition": {"join_verify_enabled": true}
      },
      "join_verify_recall": {
        "type": "bool",
        "description": "验证期间撤回该成员的非答案发言",
        "default": true,
        "hint": "开启后（需机器人有管理权限）会撤回待验证成员的消息，防止刷屏；关闭则仅提示。",
        "condition": {"join_verify_enabled": true}
      },
      "join_verify_kick": {
        "type": "bool",
        "description": "验证失败时移出群聊",
        "default": true,
        "hint": "关闭后只作提示，不踢人（适合先观察）。",
        "condition": {"join_verify_enabled": true}
      },
      "join_verify_public_result": {
        "type": "bool",
        "description": "公开提示验证结果",
        "default": true,
        "hint": "开启后验证通过/失败都会在群里 @ 该成员提示；关闭则静默处理。",
        "condition": {"join_verify_enabled": true}
      }
    }
  }
}
