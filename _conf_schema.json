{
  "list_card": {
    "description": "长列表图片卡片",
    "hint": "搜索结果条目多时自动出图；关闭后全部回到纯文本。高级项已收起。",
    "type": "object",
    "default": {},
    "items": {
      "list_card_enabled": {
        "type": "bool",
        "description": "启用长列表图片",
        "default": true,
        "hint": "开启后条目超过阈值时发图片；需安装 playwright（插件自带 Chromium 或本机 Chrome）。关闭后全部回到纯文本。"
      },
      "list_card_threshold": {
        "type": "int",
        "description": "触发图片的条目数阈值",
        "default": 5,
        "min": 1,
        "max": 50,
        "hint": "结果条数大于该值就出图；默认 5。条目少但纯文本很长时也会自动出图。",
        "condition": {
          "list_card_enabled": true
        }
      }
    }
  },
  "browser": {
    "description": "浏览器",
    "hint": "本地 Chromium 渲染（可选）；留空使用插件自带浏览器或 AstrBot 内置渲染。",
    "type": "object",
    "default": {},
    "items": {
      "browser_channel": {
        "type": "string",
        "description": "Playwright 浏览器",
        "default": "",
        "hint": "填 chrome 用本机 Chrome；留空用插件自带 Chromium。"
      },
      "browser_exe": {
        "type": "string",
        "description": "浏览器可执行路径（留空=自动）",
        "default": "",
        "hint": "留空自动选择。"
      }
    }
  },
  "game": {
    "description": "游戏资源",
    "hint": "游戏搜索源、结果上限、账号凭据与游戏日报；凭据/日报时间在「更多配置」里。",
    "type": "object",
    "default": {},
    "items": {
      "game_source": {
        "type": "string",
        "description": "游戏搜索源",
        "default": "auto",
        "hint": "auto（默认）：有 xdgame 账密走 xdgame，否则走 switch618；也可填 xdgame / switch618 强制。"
      },
      "max_search_results": {
        "type": "int",
        "description": "最大搜索结果数",
        "default": 32,
        "min": 1,
        "max": 48,
        "hint": "默认 32，最大 48。"
      },
      "xdgame_username": {
        "type": "string",
        "description": "xdgame.com 账号",
        "default": "",
        "hint": "用于 /game_cookie_refresh 自动登录刷新 Cookie。",
        "collapsed": true
      },
      "xdgame_password": {
        "type": "string",
        "description": "xdgame.com 密码",
        "default": "",
        "hint": "用于 /game_cookie_refresh 自动登录刷新 Cookie。",
        "collapsed": true
      },
      "cookie": {
        "type": "text",
        "description": "xdgame.com Cookie",
        "default": "",
        "hint": "自动登录后写入，一般无需手填。",
        "collapsed": true
      },
      "switch618_cookie": {
        "type": "text",
        "description": "switch618.com 登录 Cookie",
        "default": "",
        "hint": "switch618 源扫码登录后自动写入，一般无需手填。",
        "collapsed": true
      },
      "game_report_enabled": {
        "type": "bool",
        "description": "游戏日报总开关",
        "default": true,
        "hint": "开启后按本组时间每天自动推送游戏日报到「游戏日报推送群」；时间与群号仅在本组填写，不要填到其它分组。"
      },
      "game_report_max": {
        "type": "int",
        "description": "游戏日报每期最多游戏数",
        "default": 24,
        "min": 1,
        "max": 50,
        "hint": "默认 24，最大 50。",
        "condition": {
          "game_report_enabled": true
        },
        "collapsed": true
      },
      "game_schedule_hour": {
        "type": "int",
        "description": "游戏日报推送小时（0-23）",
        "default": 23,
        "min": 0,
        "max": 23,
        "hint": "游戏日报独立定时，与软件/影视/短剧日报分开。",
        "condition": {
          "game_report_enabled": true
        },
        "collapsed": true
      },
      "game_schedule_minute": {
        "type": "int",
        "description": "游戏日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。",
        "condition": {
          "game_report_enabled": true
        },
        "collapsed": true
      },
      "game_group_ids": {
        "type": "list",
        "description": "游戏日报推送群 ID",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "填入群号，可多个；留空则不推送。",
        "condition": {
          "game_report_enabled": true
        },
        "collapsed": true
      }
    }
  },
  "software": {
    "description": "软件资源",
    "hint": "软件日报的推送时间与目标群。",
    "type": "object",
    "default": {},
    "items": {
      "schedule_hour": {
        "type": "int",
        "description": "软件日报推送小时（0-23）",
        "default": 22,
        "min": 0,
        "max": 23,
        "hint": "软件日报独立定时，与游戏/影视/短剧日报分开。"
      },
      "schedule_minute": {
        "type": "int",
        "description": "软件日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。"
      },
      "group_ids": {
        "type": "list",
        "description": "软件日报推送群 ID",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "填入群号，可多个；留空则不推送。",
        "collapsed": true
      }
    }
  },
  "movie": {
    "description": "影视资源",
    "hint": "影视搜索源、片库登录凭据与影视日报；高级项在「更多配置」里。",
    "type": "object",
    "default": {},
    "items": {
      "movie_source": {
        "type": "string",
        "description": "影视搜索源",
        "default": "",
        "hint": "留空自动：有片库登录走片库新站，否则回退 a123tv；也可填「片库」/「a123tv」强制。"
      },
      "muliy_release_url": {
        "type": "string",
        "description": "影视发布页地址（选填）",
        "default": "",
        "hint": "留空即用默认发布页，一般无需填写。",
        "collapsed": true
      },
      "muliy_cache_ttl": {
        "type": "int",
        "description": "新站登录态缓存秒数",
        "default": 3600,
        "min": 300,
        "max": 86400,
        "hint": "默认 3600 秒，到期自动重登。",
        "collapsed": true
      },
      "muliy_username": {
        "type": "string",
        "description": "片库（新站）账号（选填）",
        "default": "",
        "hint": "选填。与密码搭配，插件自动登录片库新站，无需搬 Cookie。",
        "collapsed": true
      },
      "muliy_password": {
        "type": "string",
        "description": "片库（新站）密码（选填）",
        "default": "",
        "hint": "选填。与账号搭配自动登录。",
        "collapsed": true
      },
      "muliy_cookie": {
        "type": "text",
        "description": "片库（新站）Cookie（选填，可用账号密码替代）",
        "default": "",
        "hint": "选填。含 app_auth、PHPSESSID 即可；勿填 browser_verified / browser_pow（插件会自动求解）。",
        "collapsed": true
      },
      "movie_report_enabled": {
        "type": "bool",
        "description": "影视日报总开关",
        "default": true,
        "hint": "开启后按本组时间每天推送影视日报（未配片库时自动用 a123tv 免登录出报）。"
      },
      "movie_report_max": {
        "type": "int",
        "description": "影视日报每个区块最多部数",
        "default": 24,
        "min": 1,
        "max": 50,
        "hint": "电影/剧集/动漫每块各取前 N 部，默认 24。",
        "condition": {
          "movie_report_enabled": true
        },
        "collapsed": true
      },
      "movie_sections": {
        "type": "list",
        "description": "影视日报包含的区块",
        "default": [
          "mv",
          "tv",
          "ac"
        ],
        "items": {
          "type": "string"
        },
        "hint": "mv=电影 / tv=剧集 / ac=动漫，可多选。",
        "condition": {
          "movie_report_enabled": true
        },
        "collapsed": true
      },
      "movie_schedule_hour": {
        "type": "int",
        "description": "影视日报推送小时（0-23）",
        "default": 20,
        "min": 0,
        "max": 23,
        "hint": "影视日报独立定时，与软件/游戏/短剧日报分开。",
        "condition": {
          "movie_report_enabled": true
        },
        "collapsed": true
      },
      "movie_schedule_minute": {
        "type": "int",
        "description": "影视日报推送分钟（0-59）",
        "default": 0,
        "min": 0,
        "max": 59,
        "hint": "独立于其它日报。",
        "condition": {
          "movie_report_enabled": true
        },
        "collapsed": true
      },
      "movie_group_ids": {
        "type": "list",
        "description": "影视日报推送群 ID",
        "default": [],
        "items": {
          "type": "string"
        },
        "hint": "填入群号，可多个；留空则不推送。",
        "condition": {
          "movie_report_enabled": true
        },
        "collapsed": true
      }
    }
  },
  "shortdrama": {
